{
  "build": {
    "arduino": {
      "ldscript": "esp32c6_out.ld"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32C6_EVB",
      "-DARDUINO_USB_MODE=1"
    ],
    "f_cpu": "160000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32c6",
    "variant": "esp32c6-evb"
  },
  "connectivity": [
    "bluetooth",
    "thread",
    "wifi",
    "zigbee"
  ],
  "debug": {
    "openocd_target": "esp32c6.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "OLIMEX ESP32-C6-EVB",
  "upload": {
    "flash_size": "4MB",
    "maximum_ram_size": 327680,
    "maximum_size": 4194304,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "https://www.olimex.com/Products/IoT/ESP32-C6/ESP32-C6-EVB/open-source-hardware",
  "vendor": "OLIMEX"
}
