{
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "partitions": "default_8MB.csv"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_HELTEC_WIRELESS_STICK_V3",
      "-DARDUINO_RUNNING_CORE=1",
      "-DARDUINO_EVENT_RUNNING_CORE=1",
      "-DREGION_EU868",
      "-DMCU_ESP32_S3",
      "-DHELTEC_BOARD=31",
      "-DWIRELESS_STICK_V3",
      "-DRADIO_CHIP_SX1262",
      "-DACTIVE_REGION=LORAMAC_REGION_EU868",
      "-DLORAWAN_PREAMBLE_LENGTH=8",
      "-DHELTEC_WIRELESS_STICK_V3",
      "-DARDUINO_USB_MODE=1"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "hwids": [
