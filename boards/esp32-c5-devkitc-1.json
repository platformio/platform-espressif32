{
  "build": {
    "arduino": {
      "ldscript": "esp32c5_out.ld"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32C5_DEV",
      "-DESP32=ESP32",
      "-DARDUINO_USB_MODE=1"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32c5",
    "variant": "esp32c5"
  },
  "connectivity": [
    "bluetooth",
    "thread",
    "wifi",
    "zigbee"
  ],
  "debug": {
    "openocd_target": "esp32c5.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "Espressif ESP32-C5-DevKitC-1",
  "upload": {
    "flash_size": "4MB",
    "maximum_ram_size": 327680,
    "maximum_size": 4194304,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32c5/esp32-c5-devkitc-1/index.html",
  "vendor": "Espressif"
}
